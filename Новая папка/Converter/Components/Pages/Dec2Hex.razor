@page "/Dec2Hex"
@rendermode InteractiveServer

<h3>Dec2Hex</h3>

<div class="converter">
	<div>
		<label for="number">Десятичное число:</label>
		<input	type="number"
				id="number"
				@bind="number" @bind:after="Calculate"
				class="form-control"
				/>
		<button @onclick="Calculate" class="btn btn-primary">Перевести</button>
	</div>
	<div id="converter-result">
		@if (string.IsNullOrEmpty(result))
		{
				<span>Введите число и нажмите «Перевести»</span>
		}
		else
		{
			@($"{number} (dec) = {result} (hex)")
		}
	</div>
</div>
