@page "/Fibonacci"
@rendermode InteractiveServer

<h3>Fibonacci</h3>

<div class="fibonacci">
	<div>
		<label for="limit">Вывести числа Фибоначчи до:</label>
		<input	type="number"
				id="limit"
				@bind="limit" @bind:after="Calculate"
				class="form-control"
				/>
		<button @onclick="Calculate" class="btn btn-primary">Вычислить</button>
	</div>
	<div id="fibonacci-result">
		@if (numbers.Count == 0)
		{
				<span>Введите число и нажмите «Вычислить»</span>
		}
		else
		{
			@string.Join(", ", numbers)
		}
	</div>
</div>