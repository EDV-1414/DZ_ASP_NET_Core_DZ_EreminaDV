@page "/teachers/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Детали преподавателя</PageTitle>

<div>
    @if (teacher is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <div class="controls">
            <h1>@teacher.last_name @teacher.first_name @teacher.middle_name</h1>
        </div>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">Фамилия</dt>
            <dd class="col-sm-10">@teacher.last_name</dd>

            <dt class="col-sm-2">Имя</dt>
            <dd class="col-sm-10">@teacher.first_name</dd>

            <dt class="col-sm-2">Отчество</dt>
            <dd class="col-sm-10">@teacher.middle_name</dd>

            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@teacher.email</dd>

            <dt class="col-sm-2">Ставка</dt>
            <dd class="col-sm-10">@teacher.rate</dd>
        </dl>

        <!-- Блок с дисциплинами -->
        <h3>Дисциплины, которые ведет преподаватель:</h3>
        @if (teacher.Disciplines != null && teacher.Disciplines.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var discipline in teacher.Disciplines)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@discipline.discipline_name (Часов: @discipline.number_of_lessons)</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>У этого преподавателя пока нет привязанных дисциплин.</p>
        }

        <!-- Блок ДОБАВЛЕНИЯ дисциплины -->
        <div class="card mt-4">
            <div class="card-header">
                <h4>Добавить дисциплину</h4>
            </div>
            <div class="card-body">
                @if (availableDisciplines.Any())
                {
                    <div class="row">
                        <div class="col-md-6">
                            <select class="form-select" @bind="selectedDisciplineId">
                                <option value="0">-- Выберите дисциплину --</option>
                                @foreach (var disc in availableDisciplines)
                                {
                                    <option value="@disc.discipline_id">@disc.discipline_name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-success" @onclick="AddDiscipline" disabled="@(selectedDisciplineId == 0)">
                                Добавить
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p>Все доступные дисциплины уже привязаны к этому преподавателю.</p>
                }
            </div>
        </div>

        <div class="mt-3">
            <a href="/teachers">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Teacher? teacher;
    private List<Discipline> availableDisciplines = new();
    private int selectedDisciplineId = 0;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var context = DbFactory.CreateDbContext();

        // 1. Загружаем преподавателя с его дисциплинами
        teacher = await context.Teachers
            .Include(t => t.Disciplines)
            .FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NavigateTo("notfound");
            return;
        }

        // 2. Загружаем все дисциплины, которых у него еще нет
        var currentDisciplineIds = teacher.Disciplines?.Select(d => d.discipline_id).ToList() ?? new List<int>();
        availableDisciplines = await context.Disciplines
            .Where(d => !currentDisciplineIds.Contains(d.discipline_id))
            .ToListAsync();
    }

    private async Task AddDiscipline()
    {
        if (selectedDisciplineId == 0 || teacher == null) return;

        using var context = DbFactory.CreateDbContext();

        // Находим преподавателя и дисциплину в контексте
        var teacherToUpdate = await context.Teachers
            .Include(t => t.Disciplines)
            .FirstOrDefaultAsync(t => t.teacher_id == teacher_id);

        var disciplineToAdd = await context.Disciplines.FindAsync(selectedDisciplineId);

        if (teacherToUpdate != null && disciplineToAdd != null)
        {
            // Добавляем дисциплину в коллекцию преподавателя
            teacherToUpdate.Disciplines ??= new List<Discipline>();
            teacherToUpdate.Disciplines.Add(disciplineToAdd);

            await context.SaveChangesAsync();
        }

        // Сбрасываем выбор и перезагружаем данные
        selectedDisciplineId = 0;
        await LoadData();
    }
}