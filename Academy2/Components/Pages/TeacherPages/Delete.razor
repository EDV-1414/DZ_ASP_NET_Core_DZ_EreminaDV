@page "/teachers/delete"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удалить преподавателя</PageTitle>

<h1>Удалить</h1>
<p>Вы уверены, что хотите удалить этого преподавателя?</p>
<div>
    @if (teacher is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else
    {
        <h2>@teacher.last_name @teacher.first_name</h2>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">Фамилия</dt>
            <dd class="col-sm-10">@teacher.last_name</dd>
            <dt class="col-sm-2">Имя</dt>
            <dd class="col-sm-10">@teacher.first_name</dd>
        </dl>
        <EditForm method="post" Model="teacher" OnValidSubmit="DeleteTeacher" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(teacher is null)">Удалить</button> |
            <a href="/teachers">Назад к списку</a>
        </EditForm>
    }
</div>

@code {
    private Teacher? teacher;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        teacher = await context.Teachers.FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTeacher()
    {
        using var context = DbFactory.CreateDbContext();
        context.Teachers.Remove(teacher!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/teachers");
    }
}