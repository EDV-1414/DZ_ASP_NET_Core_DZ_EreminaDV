@page "/groups/details"
@using Microsoft.EntityFrameworkCore
@using Academy2.Models
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>
<div>
	@if (group is null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<div class="controls">
			<h1>@group.group_name</h1>
			<a href="@($"/groups/edit?group_id={group.group_id}")" class="btn btn-primary">Edit</a>
		</div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">group_name</dt>
			<dd class="col-sm-10">@group.group_name</dd>
			<dt class="col-sm-2">direction</dt>
			<dd class="col-sm-10">@group.Direction?.direction_name</dd>
			<dt class="col-sm-2">learning_days</dt>
			<dd class="col-sm-10">@(new Week((int)(group.learning_days ?? 0)))</dd>
			<dt class="col-sm-2">start_time</dt>
			<dd class="col-sm-10">@group.start_time</dd>
			<dt class="col-sm-2">start_date</dt>
			<dd class="col-sm-10">@group.start_date</dd>
			@* Добавлено для пункта 6 *@
			<dt class="col-sm-2">Количество студентов</dt>
			<dd class="col-sm-10">@students.Count</dd>
		</dl>

		<h3>Студенты группы</h3>
		@if (students == null || students.Count == 0)
		{
			<p><em>В этой группе пока нет студентов.</em></p>
		}
		else
		{
			<ul>
				@foreach (var student in students)
				{
					<li>
						<a href="@($"/students/details?stud_id={student.stud_id}")">@student.full_name</a>
					</li>
				}
			</ul>
		}

		<div>
			<a href="@($"/groups")">Back to List</a>
		</div>
	}
</div>

@code {
	private Group? group;
	private List<Student> students = new();

	[SupplyParameterFromQuery]
	private int group_id { get; set; }

	protected override async Task OnInitializedAsync()
	{
		using var context = DbFactory.CreateDbContext();
		group = await context.Groups.Include(g => g.Direction).FirstOrDefaultAsync(m => m.group_id == group_id);

		if (group is null)
		{
			NavigationManager.NavigateTo("notfound");
		}
		else
		{
			students = await context.Students
				.Where(s => s.group == group_id)
				.OrderBy(s => s.last_name)
				.ToListAsync();
		}
	}
}