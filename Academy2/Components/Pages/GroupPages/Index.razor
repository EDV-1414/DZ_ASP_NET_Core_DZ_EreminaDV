@page "/groups"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy2.Models
@using Academy2.Data
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory

<PageTitle>Группы</PageTitle>

<div class="controls">
    <h1>Группы (Groups)</h1>
    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Поиск по названию группы..."
                   @bind="searchString" @bind:event="oninput" />
        </div>
    </div>
</div>

<QuickGrid TGridItem="Group" Class="table" ItemsProvider="GetGroups" Pagination="@pagination">
    <PropertyColumn Property="g => g.group_name" Title="Название группы" Sortable="true" />
    <!-- Выводим название направления из связанной таблицы -->
    <PropertyColumn Property="g => g.Direction.direction_name" Title="Направление" Sortable="true" />
    <PropertyColumn Property="g => g.learning_days" Title="Дни обучения" Sortable="true" />
    <PropertyColumn Property="g => g.start_time" Title="Время начала" Sortable="true" />
    <PropertyColumn Property="group => group.start_date" Title="Дата начала" Sortable="true" />

    <TemplateColumn Title="Действия" Context="item">
        <a href="@($"groups/edit?group_id={item.group_id}")">Edit</a> |
        <a href="@($"groups/details?group_id={item.group_id}")">Details</a> |
        <a href="@($"groups/delete?group_id={item.group_id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="@pagination" />

@code {
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string searchString = "";

    private async ValueTask<GridItemsProviderResult<Group>> GetGroups(GridItemsProviderRequest<Group> request)
    {
        using var context = DbFactory.CreateDbContext();

        // Включаем связанные данные (Direction), чтобы получить direction_name
        var query = context.Groups.Include(g => g.Direction).AsQueryable();

        // Поиск
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(g => g.group_name.Contains(searchString));
        }

        // Сортировка
        if (request.SortByColumn != null)
        {
            query = request.ApplySorting(query);
        }
        else
        {
            query = query.OrderBy(g => g.group_id);
        }

        int totalCount = await query.CountAsync();
        var items = await query
            .Skip(request.StartIndex)
            .Take(request.Count ?? 10)
            .ToListAsync();

        return GridItemsProviderResult.From(items, totalCount);
    }
}