@page "/directions"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Academy2.Models
@using Academy2.Data
@inject IDbContextFactory<Academy2.Data.AcademyContext> DbFactory

<PageTitle>Направления</PageTitle>

<div class="controls">
    <h1>Направления обучения (Directions)</h1>
    <p>
        <a href="directions/create" class="btn btn-primary">Добавить направление обучения</a>
    </p>

    <!-- Поиск -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Поиск по названию..."
                   @bind="searchString" @bind:event="oninput" />
        </div>
    </div>
</div>

<!-- Используем ItemsProvider для сортировки проверка связи-->
<QuickGrid TGridItem="Direction" Class="table" ItemsProvider="GetDirections" Pagination="@pagination">
    <PropertyColumn Property="d => d.direction_name" Title="Название направления" Sortable="true" />

    <TemplateColumn Title="Действия" Context="item">
        <a href="@($"directions/details?direction_id={item.direction_id}")">Детали</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="@pagination" />

@code {
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private string searchString = "";

    private async ValueTask<GridItemsProviderResult<Direction>> GetDirections(GridItemsProviderRequest<Direction> request)
    {
        using var context = DbFactory.CreateDbContext();
        var query = context.Directions.AsQueryable();

        // 1. Применяем поиск
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(d => d.direction_name.Contains(searchString));
        }

        // 2. Применяем сортировку (официальный метод QuickGrid)
        if (request.SortByColumn != null)
        {
            query = request.ApplySorting(query);
        }
        else
        {
            query = query.OrderBy(d => d.direction_id); // По умолчанию
        }

        // 3. Считаем общее количество
        int totalCount = await query.CountAsync();

        // 4. Пагинация
        var items = await query
            .Skip(request.StartIndex)
            .Take(request.Count ?? 10)
            .ToListAsync();

        return GridItemsProviderResult.From(items, totalCount);
    }
}